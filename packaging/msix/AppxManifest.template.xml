<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Microsoft Store. scripts/build_msix.ps1 fills the
  {{TOKENS}} in from the values Partner Center gives you under
  Product identity (Package/Identity/Name, Publisher, PublisherDisplayName).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>SmartCalender</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Calendar, tasks and reminders in one fast desktop app.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="SmartCalender" Executable="SmartCalender.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="SmartCalender"
        Description="Calendar, tasks and reminders in one fast desktop app."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          ShortName="SmartCalender" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <!-- Required for every packaged Win32 (PyInstaller) desktop app -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
