/* =========================
   MAIN WINDOW
   ========================= */
QMainWindow {
   background-color: #111827;
}


/* =========================
   TOP HEADER BAR
   ========================= */
QWidget#HeaderBar {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #1F2937,
        stop:0.4 #1F2937,
        stop:0.7 #374151,
        stop:1 #065F46
    );
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

/* Header app logo and title (live in HeaderBar, not in the sidebar) */
QLabel#AppLogo {
    font-size: 24px;
    padding-left: 4px;
    padding-right: 2px;
}

QLabel#AppTitle {
    color: #F3F6FA;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

QPushButton#SegmentButton {
    min-width: 100px;
    min-height: 30px;
    padding: 2px 4px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background-color: rgba(16, 185, 129, 0.20);
    color: #F4F7FB;
    font-size: 15px;
    font-weight: 700;
}

QPushButton#SegmentButton:checked {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #10B981,
        stop:1 #10B981
    );
    border: 1px solid rgba(255,255,255,0.14);
    color: white;
}

QPushButton#SegmentButton:hover:!checked {
    background-color: rgba(16, 185, 129, 0.30);
}

QPushButton#AddTaskButton {
    min-width: 100px;
    min-height: 30px;
    padding: 4px 16px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background-color: #10B981;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 600;
    font-family: "Segoe UI", "Inter", "Helvetica Neue", Arial, sans-serif;
}

QPushButton#AddTaskButton:hover {
    background-color: #059669;
    border: 1px solid rgba(255, 255, 255, 0.2);
}

QPushButton#AddTaskButton:pressed {
    background-color: #047857;
}

/* =========================
   SEARCH BAR
   ========================= */
QWidget#SearchContainer {
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    min-width: 180px;
    max-width: 180px;
}

QLabel#SearchIcon {
    color: #A0B4D0;
    font-size: 14px;
    background: transparent;
    border: none;
    padding: 0px;
}

QLineEdit#SearchInput {
    background: transparent;
    border: none;
    color: #F3F6FA;
    font-family: "Segoe UI", "Inter", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
    font-weight: 400;
    padding: 0px;
}

QLineEdit#SearchInput::placeholder {
    color: #A0B4D0;
}

QLineEdit#SearchInput:focus {
    outline: none;
}

/* =========================
   USER ICON
   ========================= */
QWidget#UserContainer {
    background: transparent;
    border: none;
}

QLabel#UserIconEmoji {
    font-size: 18px;
    background: transparent;
    border: none;
    padding: 0px;
    min-width: 20px;
}

QLabel#UserInitial {
    background-color: rgba(255, 255, 255, 0.15);
    border: 2px solid rgba(255, 255, 255, 0.25);
    border-radius: 14px;
    color: #F3F6FA;
    font-family: "Segoe UI", "Inter", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
    font-weight: 600;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
}

/* =========================
   DATE LABEL
   ========================= */
QLabel#HeaderDateLabel {
    color: #FFFFFF;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 18px;
    font-weight: 600;
    padding: 4px 2px;
}
/* =========================
   CONTENT SURFACE
   Use this on your main central widget if possible
   ========================= */
QWidget#MainContent,
QFrame#MainContent {
    background-color: #F8FAFC;
}

/* =========================
   SECTION / CARD SURFACE
   ========================= */
QWidget#SurfaceCard,
QFrame#SurfaceCard {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
}


/* =========================
   SEGMENTED BUTTONS
   ========================= */

QPushButton#SegmentButton:hover {
    background-color: rgba(255, 255, 255, 0.14);
    color: #FFFFFF;
}

QPushButton#SegmentButton:checked {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #10B981,
        stop:1 #10B981
    );
    color: #FFFFFF;
    border: 1px solid #10B981;
}

QPushButton#SegmentButton:pressed {
    background-color: #059669;
}


/* =========================
   PRIMARY BUTTON
   ========================= */
QPushButton#PrimaryButton {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #10B981,
        stop:1 #059669
    );
    color: #FFFFFF;
    border: 1px solid #059669;
    border-radius: 10px;
    padding: 8px 18px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#PrimaryButton:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #10B981,
        stop:1 #10B981
    );
}

QPushButton#PrimaryButton:pressed {
    background-color: #059669;
}


/* =========================
   SECONDARY ICON BUTTON
   ========================= */
QPushButton#SecondaryIconButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
}

QPushButton#SecondaryIconButton:hover {
    background-color: rgba(255, 255, 255, 0.10);
}

QPushButton#SecondaryIconButton:pressed {
    background-color: rgba(255, 255, 255, 0.16);
}


/* =========================
   GENERIC LABELS INSIDE LIGHT CONTENT
   ========================= */
QWidget#MainContent QLabel,
QFrame#MainContent QLabel {
    color: #1F2937;
}


/* =========================
   OPTIONAL TOOLBAR / PANEL BUTTONS
   ========================= */
QPushButton {
    outline: none;
}


/* =========================
   INLINE INFO DIALOG
   ========================= */

QDialog#InlineInfoDialog {
    background: transparent;
}

QFrame#InlineInfoCard {
    background-color: #111827;
    border-radius: 14px;
    border: 1px solid rgba(148, 163, 184, 0.55);
    box-shadow: 0 18px 45px rgba(11, 15, 20, 0.65);
}

QLabel#InlineInfoIcon {
    font-size: 30px;
}

QLabel#InlineInfoTitle {
    color: #E5E7EB;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 15px;
    font-weight: 600;
}

QLabel#InlineInfoBody,
QLabel#InlineInfoDetail {
    color: #D1FAE5;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

QPushButton#InlineInfoPrimaryButton {
    min-width: 90px;
    padding: 6px 18px;
    border-radius: 999px;
    border: none;
    color: #F9FAFB;
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #22C55E,
        stop:1 #16A34A
    );
}

QPushButton#InlineInfoPrimaryButton:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #4ADE80,
        stop:1 #22C55E
    );
}
/* =========================
   QUICK ADD (review §4.6)
   ========================= */
QLineEdit#QuickAddInput {
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 10px;
    color: #F9FAFB;
    font-family: "Inter", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 14px;
    padding: 7px 12px;
    min-height: 20px;
}
QLineEdit#QuickAddInput:focus {
    border: 1px solid #10B981;
    background-color: rgba(16, 185, 129, 0.10);
}
QLabel#QuickAddHint {
    color: #9CA3AF;
    font-size: 12px;
    background: transparent;
}
QLabel#QuickAddHint[state="preview"] { color: #6EE7B7; }
QLabel#QuickAddHint[state="done"] { color: #34D399; font-weight: 600; }
QLabel#QuickAddHint[state="error"] { color: #FCA5A5; font-weight: 600; }

/* Keyboard focus is always visible */
QPushButton:focus { outline: none; }
QLineEdit:focus { border-color: #10B981; }
